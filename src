      <div class="agent-node">
        <div class="agent-node-box waiting" id="node-comp">⚖️</div>
        <div class="agent-node-label waiting" id="lbl-comp">Compliance</div>
      </div>
      <div class="agent-arrow" id="arr-4"></div>
