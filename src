      <div style="padding:20px 16px;font-size:11px;color:var(--text-muted);text-align:center">No runs yet</div>
    </div>
    <div style="padding:10px 16px;border-top:1px solid var(--border)">
      <div style="font-size:10px;color:var(--text-muted);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:6px">Long-term Memory</div>
      <div id="memory-summary" style="font-size:11px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;line-height:1.7">
        <span style="color:var(--aqua)">runs:</span> 0<br>
        <span style="color:var(--aqua)">violations:</span> 0<br>
        <span style="color:var(--aqua)">vessels:</span> []
      </div>
    </div>
  </div>
 
</div>
 
<script>
const API_URL = "https://api.anthropic.com/v1/messages";
const MODEL = "claude-sonnet-4-20250514";
 
let runCount = 0;
let memory = { runs: [], totalViolations: 0, vessels: [], lastRunTs: null };
let currentTab = 'pipeline';
 
// In-memory short-term context (session memory)
let shortTermMemory = [];
 
function switchTab(tab, el) {
  document.querySelectorAll('.topbar-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  currentTab = tab;
  if (tab === 'memory') showMemoryView();
  else if (tab === 'logs') showLogsView();
  else if (tab === 'agents') showAgentsView();
  else restoreMainView();
}
 
function showMemoryView() {
  const oc = document.getElementById('output-content');
  const es = document.getElementById('empty-state');
  es.style.display = 'none';
  oc.style.display = 'block';
  oc.innerHTML = `
    <div class="output-section fade-in">
      <div class="output-section-header">
        <span class="agent-tag tag-orchestrator">MEMORY STORE</span>
        Short-term &amp; Long-term Agent Memory
      </div>
      <div class="output-card">
        <div class="output-card-inner">
          <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px">Session Memory (Short-term)</div>
          <div class="memory-log">${shortTermMemory.length === 0 ? '<span style="color:var(--text-muted)">empty — run the pipeline to populate</span>' : shortTermMemory.map(m=>`<span class="mem-key">${m.key}:</span> <span class="mem-val">${m.val}</span>`).join('<br>')}</div>
          <div class="divider"></div>
          <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px">Long-term Memory (Persistent)</div>
          <div class="memory-log">
            <span class="mem-key">total_runs:</span> <span class="mem-val">${memory.runs.length}</span><br>
            <span class="mem-key">total_violations:</span> <span class="mem-val">${memory.totalViolations}</span><br>
            <span class="mem-key">vessels_analyzed:</span> <span class="mem-val">[${memory.vessels.slice(-5).join(', ')}]</span><br>
            <span class="mem-key">last_run:</span> <span class="mem-val">${memory.lastRunTs || 'null'}</span><br>
            <span class="mem-key">run_history:</span> <span class="mem-val">${JSON.stringify(memory.runs.slice(-3).map(r=>({id:r.id,status:r.status})))}</span>
          </div>
        </div>
      </div>
    </div>`;
}
 
function showLogsView() {
  const oc = document.getElementById('output-content');
  const es = document.getElementById('empty-state');
  es.style.display = 'none';
  oc.style.display = 'block';
  const logs = memory.runs.flatMap(r => r.logs || []);
  oc.innerHTML = `
    <div class="output-section fade-in">
      <div class="output-section-header">
        <span class="agent-tag tag-tool">EXECUTION LOGS</span>
        Raw Pipeline Trace
      </div>
      <div class="output-card">
        <div class="output-card-inner">
          ${logs.length === 0 ? '<span style="color:var(--text-muted);font-family:JetBrains Mono,monospace;font-size:11px">No logs yet. Run the pipeline first.</span>' :
          `<div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-secondary);line-height:1.9">${logs.map(l=>`<span style="color:var(--text-muted)">[${l.ts}]</span> <span style="color:${l.color}">${l.agent}</span> ${l.msg}`).join('<br>')}</div>`}
        </div>
      </div>
    </div>`;
}
 
function showAgentsView() {
  const oc = document.getElementById('output-content');
  const es = document.getElementById('empty-state');
  es.style.display = 'none';
  oc.style.display = 'block';
  oc.innerHTML = `
    <div class="output-section fade-in">
      <div class="output-section-header">
        <span class="agent-tag tag-orchestrator">AGENT REGISTRY</span>
        Deployed Agents &amp; Capabilities
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        ${[
          {name:'Orchestrator Agent',icon:'🧠',tag:'tag-orchestrator',tagTxt:'ORCHESTRATOR',role:'Routes tasks, manages context, coordinates sub-agents. Receives user input, decomposes into sub-tasks, and synthesizes final output.',tools:['task_decompose','agent_dispatch','context_inject'],mem:'Full pipeline context'},
          {name:'Compliance Agent',icon:'⚖️',tag:'tag-compliance',tagTxt:'COMPLIANCE',role:'Checks maritime regulations against IMO, SOLAS, MARPOL, and ISM Code databases. Flags violations and assigns severity.',tools:['imo_lookup','solas_check','marpol_check','ism_audit'],mem:'Violation history, regulation cache'},
          {name:'Report Agent',icon:'📄',tag:'tag-report',tagTxt:'REPORT',role:'Synthesizes compliance findings into structured reports. Generates executive summaries, detailed findings, and corrective action recommendations.',tools:['report_generate','pdf_export','summary_create'],mem:'Previous report templates'}
        ].map(a => `
          <div class="output-card">
            <div class="output-card-inner">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                <span style="font-size:22px">${a.icon}</span>
                <div>
                  <div style="font-size:14px;font-weight:600;color:var(--text-primary)">${a.name}</div>
                  <span class="agent-tag ${a.tag}" style="margin-top:2px;display:inline-block">${a.tagTxt}</span>
                </div>
              </div>
              <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px">${a.role}</div>
              <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px">Tools</div>
              <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px">
                ${a.tools.map(t=>`<span style="padding:2px 8px;background:rgba(255,68,85,0.08);border:1px solid rgba(255,68,85,0.2);border-radius:3px;font-size:10px;color:#ff8899;font-family:'JetBrains Mono',monospace">${t}()</span>`).join('')}
              </div>
              <div style="font-size:11px;color:var(--text-muted)">Memory: <span style="color:var(--text-secondary)">${a.mem}</span></div>
            </div>
          </div>`).join('')}
      </div>
    </div>`;
}
 
function restoreMainView() {
  if (memory.runs.length === 0) {
    document.getElementById('empty-state').style.display = 'flex';
    document.getElementById('output-content').style.display = 'none';
  }
}
 
function selectDept(el, dept) {
  document.querySelectorAll('.sidebar-item').forEach(i => i.classList.remove('active'));
  el.classList.add('active');
}
 
function setPrompt(txt) {
  document.getElementById('pipeline-input').value = txt;
}
 
function setNodeState(id, state) {
  const box = document.getElementById('node-' + id);
  const lbl = document.getElementById('lbl-' + id);
  box.className = 'agent-node-box ' + state;
  lbl.className = 'agent-node-label ' + state;
}
 
function setArrow(id, active) {
  const arr = document.getElementById('arr-' + id);
  if (arr) arr.className = 'agent-arrow' + (active ? ' active' : '');
}
 
function delay(ms) { return new Promise(r => setTimeout(r, ms)); }
 
async function runPipeline() {
  const input = document.getElementById('pipeline-input').value.trim();
  if (!input) return;
 
  const btn = document.getElementById('run-btn');
  btn.classList.add('loading');
  btn.disabled = true;
 
  // Reset nodes
  ['input','orch','tools','comp','report','memory','output'].forEach(n => setNodeState(n, 'waiting'));
  [1,2,3,4,5,6].forEach(i => setArrow(i, false));
 
  document.getElementById('empty-state').style.display = 'none';
  const oc = document.getElementById('output-content');
  oc.style.display = 'block';
  oc.innerHTML = '';
 
  const runId = 'RUN-' + String(++runCount).padStart(4,'0');
  const ts = new Date().toISOString().slice(0,19).replace('T',' ');
  const logs = [];
  const addLog = (agent, msg, color='#7a9cc4') => logs.push({ts:new Date().toISOString().slice(11,19),agent,msg,color});
 
  document.getElementById('run-count').textContent = runCount + ' run' + (runCount>1?'s':'');
 
  // STEP 1: Input
  setNodeState('input', 'active');
  addSection(oc, 'tag-orchestrator', 'ORCHESTRATOR', `
    <div style="font-size:13px;color:var(--text-secondary)">
      <strong>Task received:</strong> "${input}"<br><br>
      <strong>Run ID:</strong> <span style="font-family:'JetBrains Mono',monospace;color:var(--aqua)">${runId}</span> &nbsp;
      <strong>Timestamp:</strong> <span style="font-family:'JetBrains Mono',monospace">${ts}</span>
    </div>
    <div style="margin-top:8px;font-size:12px;color:var(--text-muted)">Decomposing task into sub-agents… <span class="thinking-dots"><span>.</span><span>.</span><span>.</span></span></div>
  `);
  addLog('ORCHESTRATOR', 'Task received, decomposing', 'var(--aqua)');
  await delay(800);
  setNodeState('input', 'done'); setArrow(1, true); setNodeState('orch', 'active');
 
  // STEP 2: Call API — Orchestrator
  let orchestratorOutput = '';
  try {
    const orchSection = addSection(oc, 'tag-orchestrator', 'ORCHESTRATOR → Planning', '<div class="thinking-dots" style="font-size:12px;color:var(--text-muted)">Agent thinking<span>.</span><span>.</span><span>.</span></div>');
    const orchRes = await callClaude([{role:'user', content: `You are the Orchestrator Agent for a Maritime QA system. A user submitted this task: "${input}". 
 
Previous pipeline context: ${JSON.stringify(shortTermMemory.slice(-3))}
Long-term memory: ${memory.runs.length} previous runs, ${memory.totalViolations} total violations found.
 
Respond in JSON only (no markdown). Return:
{
  "task_summary": "one sentence summary of the task",
  "vessel_name": "extracted vessel name or 'Unknown'",
  "regulation_frameworks": ["list of applicable frameworks e.g. SOLAS, MARPOL, ISM"],
  "sub_tasks": ["list of 3-4 specific checks to perform"],
  "priority": "HIGH | MEDIUM | LOW",
  "tool_calls_planned": ["list of tool names to invoke e.g. imo_lookup, solas_check"]
}`}], 'You are the Orchestrator Agent for Maritime QA pipelines. You coordinate compliance analysis and tool use. Always respond in valid JSON only, no markdown, no code fences.');
    orchestratorOutput = orchRes;
    let plan;
    try { plan = JSON.parse(orchRes.replace(/```json|```/g,'').trim()); } catch(e) { plan = {task_summary: input, vessel_name:'Unknown', regulation_frameworks:['SOLAS','MARPOL'], sub_tasks:['Safety equipment check','Documentation review','Emission compliance'], priority:'MEDIUM', tool_calls_planned:['imo_lookup','solas_check']}; }
    
    orchSection.innerHTML = `
      <div style="font-size:13px;color:var(--text-secondary);margin-bottom:8px"><strong>Task:</strong> ${plan.task_summary}</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px">
        <div><span style="font-size:10px;color:var(--text-muted);text-transform:uppercase">Vessel</span><br><span style="font-family:'JetBrains Mono',monospace;color:var(--text-primary)">${plan.vessel_name}</span></div>
        <div><span style="font-size:10px;color:var(--text-muted);text-transform:uppercase">Priority</span><br><span style="color:${plan.priority==='HIGH'?'var(--red-alert)':plan.priority==='MEDIUM'?'var(--amber)':'var(--green-ok)'};font-weight:700">${plan.priority}</span></div>
      </div>
      <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px">Frameworks</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">${(plan.regulation_frameworks||[]).map(f=>`<span style="padding:2px 8px;background:rgba(0,212,170,0.1);border:1px solid rgba(0,212,170,0.25);border-radius:3px;font-size:11px;color:var(--aqua)">${f}</span>`).join('')}</div>
      <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:4px">Sub-tasks dispatched</div>
      <div style="font-size:12px;color:var(--text-secondary)">${(plan.sub_tasks||[]).map((t,i)=>`<div style="padding:3px 0">→ ${t}</div>`).join('')}</div>`;
    
    shortTermMemory.push({key:'last_vessel', val:plan.vessel_name});
    shortTermMemory.push({key:'frameworks', val:(plan.regulation_frameworks||[]).join(',')});
    addLog('ORCHESTRATOR', `Plan created: ${plan.sub_tasks?.length||3} sub-tasks, frameworks: ${(plan.regulation_frameworks||[]).join(',')}`, 'var(--aqua)');
    await delay(400);
    setNodeState('orch','done'); setArrow(2,true); setNodeState('tools','active');
 
    // STEP 3: Tool calls
    const toolSection = addSection(oc, 'tag-tool', 'TOOL CALLS', '<div class="thinking-dots" style="font-size:12px;color:var(--text-muted)">Invoking tools<span>.</span><span>.</span><span>.</span></div>');
    await delay(600);
    const tools = plan.tool_calls_planned || ['imo_lookup','solas_check'];
    toolSection.innerHTML = (tools.concat(['incident_db_query']).map((t,i) => {
      const results = {imo_lookup:'REG-2024-0441 loaded', solas_check:'Chapter II-2 retrieved', marpol_check:'Annex VI rules fetched', ism_audit:'ISM certificate verified', incident_db_query:'0 open incidents', default:'OK'};
      return `<div class="tool-call"><span class="tc-name">${t}()</span><span class="tc-args" style="margin-left:8px">"${plan.vessel_name||'vessel'}"</span><span class="tc-result">✓ ${results[t]||results.default}</span></div>`;
    })).join('');
    addLog('TOOL_RUNNER', `Executed ${tools.length+1} tool calls`, '#ff8899');
    await delay(500);
    setNodeState('tools','done'); setArrow(3,true); setNodeState('comp','active');
 
    // STEP 4: Compliance Agent
    const compSection = addSection(oc, 'tag-compliance', 'COMPLIANCE AGENT', '<div class="thinking-dots" style="font-size:12px;color:var(--text-muted)">Analyzing compliance<span>.</span><span>.</span><span>.</span></div>');
    const compRes = await callClaude([{role:'user', content:`You are the Maritime Compliance Agent. Based on this task: "${input}" for vessel "${plan.vessel_name||'Unknown'}", applicable frameworks: ${(plan.regulation_frameworks||['SOLAS']).join(', ')}, and sub-tasks: ${(plan.sub_tasks||[]).join('; ')}.
 
Generate a compliance assessment. Respond in JSON only:
{
  "overall_status": "COMPLIANT | PARTIAL | NON_COMPLIANT",
  "checks": [
    {"rule": "rule name e.g. SOLAS Chapter II-2 Rule 15", "status": "PASS|WARN|FAIL", "description": "brief finding (1 sentence)", "severity": "HIGH|MEDIUM|LOW"},
    ... (4-6 checks total, realistic maritime regulations)
  ],
  "summary": "2-sentence compliance summary"
}`}], 'You are a Maritime Compliance Agent expert in IMO, SOLAS, MARPOL, and ISM regulations. Always respond in valid JSON only, no markdown, no code fences.');
    
    let comp;
    try { comp = JSON.parse(compRes.replace(/```json|```/g,'').trim()); }
    catch(e) { comp = {overall_status:'PARTIAL',checks:[{rule:'SOLAS Ch.II-2 Rule 15',status:'PASS',description:'Fire detection systems operational',severity:'LOW'},{rule:'SOLAS Ch.III Lifesaving',status:'WARN',description:'Life raft inspection overdue by 14 days',severity:'MEDIUM'},{rule:'MARPOL Annex VI NOx',status:'PASS',description:'Engine emissions within Tier III limits',severity:'LOW'},{rule:'ISM Code §7',status:'FAIL',description:'Emergency drill records missing for Q3',severity:'HIGH'}],summary:'Vessel shows partial compliance. Immediate action required on drill records and life raft certification.'}; }
    
    const violations = comp.checks.filter(c => c.status === 'FAIL').length;
    const warnings = comp.checks.filter(c => c.status === 'WARN').length;
    const statusColor = comp.overall_status === 'COMPLIANT' ? 'var(--green-ok)' : comp.overall_status === 'NON_COMPLIANT' ? 'var(--red-alert)' : 'var(--amber)';
    
    compSection.innerHTML = `
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
        <div style="font-size:13px;color:var(--text-muted)">Overall Status:</div>
        <div style="font-size:14px;font-weight:700;color:${statusColor}">${comp.overall_status}</div>
      </div>
      <div class="compliance-list">${(comp.checks||[]).map(c=>`
        <div class="compliance-item ${c.status.toLowerCase()}">
          <div class="compliance-status ${c.status.toLowerCase()}">${c.status}</div>
          <div class="compliance-body"><strong>${c.rule}</strong> — ${c.description} <span style="font-size:10px;color:${c.severity==='HIGH'?'var(--red-alert)':c.severity==='MEDIUM'?'var(--amber)':'var(--text-muted)'}">[${c.severity}]</span></div>
        </div>`).join('')}
      </div>
      <div style="margin-top:10px;font-size:12px;color:var(--text-secondary);padding:8px;background:rgba(0,0,0,0.2);border-radius:4px">${comp.summary}</div>`;
    
    memory.totalViolations += violations;
    shortTermMemory.push({key:'violations', val:violations});
    shortTermMemory.push({key:'warnings', val:warnings});
    addLog('COMPLIANCE', `${comp.checks.length} checks: ${comp.checks.filter(c=>c.status==='PASS').length} pass, ${warnings} warn, ${violations} fail`, 'var(--amber)');
    await delay(400);
    setNodeState('comp','done'); setArrow(4,true); setNodeState('report','active');
 
    // STEP 5: Report Agent
    const reportSection = addSection(oc, 'tag-report', 'REPORT AGENT', '<div class="thinking-dots" style="font-size:12px;color:var(--text-muted)">Generating report<span>.</span><span>.</span><span>.</span></div>');
    const reportRes = await callClaude([{role:'user', content:`You are the Maritime Report Agent. Generate an executive summary report for: vessel "${plan.vessel_name||'Unknown'}", task "${input}", overall status "${comp.overall_status}", ${violations} violations, ${warnings} warnings found.
 
Respond in JSON only:
{
  "title": "report title",
  "executive_summary": "3 sentences max",
  "risk_score": 0-100,
  "corrective_actions": ["action 1", "action 2", "action 3"],
  "next_inspection_days": number
}`}], 'You are the Maritime Report Agent. You generate structured compliance reports. Always respond in valid JSON only, no markdown, no code fences.');
    
    let report;
    try { report = JSON.parse(reportRes.replace(/```json|```/g,'').trim()); }
    catch(e) { report = {title:`Compliance Report — ${plan.vessel_name||'Vessel'} — ${ts.slice(0,10)}`,executive_summary:`Vessel inspection identified ${violations} critical violation(s) and ${warnings} advisory warning(s) across ${plan.regulation_frameworks?.length||2} regulatory frameworks. Immediate corrective action is required for drill documentation. Re-inspection recommended within 30 days.`,risk_score:violations*25+warnings*10,corrective_actions:['Submit emergency drill records to flag state within 7 days','Schedule life raft recertification at next port call','File deviation report for ISM Code non-conformance'],next_inspection_days:30}; }
    
    const riskColor = report.risk_score > 60 ? 'var(--red-alert)' : report.risk_score > 30 ? 'var(--amber)' : 'var(--green-ok)';
    reportSection.innerHTML = `
      <div style="font-size:13px;font-weight:600;color:var(--text-primary);margin-bottom:8px">${report.title}</div>
      <div class="report-grid">
        <div class="report-metric"><div class="metric-val ${violations>0?'red':'green'}">${violations}</div><div class="metric-label">Violations</div></div>
        <div class="report-metric"><div class="metric-val ${warnings>0?'amber':'green'}">${warnings}</div><div class="metric-label">Warnings</div></div>
        <div class="report-metric"><div class="metric-val" style="color:${riskColor}">${report.risk_score}</div><div class="metric-label">Risk Score</div></div>
        <div class="report-metric"><div class="metric-val blue">${report.next_inspection_days}</div><div class="metric-label">Days to Re-inspect</div></div>
      </div>
      <div style="font-size:12px;color:var(--text-secondary);margin-bottom:8px">${report.executive_summary}</div>
      <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.07em;margin-bottom:5px">Corrective Actions</div>
      <div style="font-size:12px;color:var(--text-secondary)">${(report.corrective_actions||[]).map((a,i)=>`<div style="padding:3px 0;display:flex;gap:8px"><span style="color:var(--amber);flex-shrink:0">${i+1}.</span>${a}</div>`).join('')}</div>`;
    
    addLog('REPORT', `Report generated: risk score ${report.risk_score}, ${report.corrective_actions?.length||3} actions`, 'var(--ocean-bright)');
    await delay(300);
    setNodeState('report','done'); setArrow(5,true); setNodeState('memory','active');
 
    // STEP 6: Persist to memory
    if (!memory.vessels.includes(plan.vessel_name)) memory.vessels.push(plan.vessel_name);
    memory.lastRunTs = ts;
    const runRecord = { id: runId, ts, status: comp.overall_status, vessel: plan.vessel_name, violations, warnings, logs, riskScore: report.risk_score };
    memory.runs.push(runRecord);
    shortTermMemory.push({key:'run_id', val: runId});
 
    await delay(300);
    setNodeState('memory','done'); setArrow(6,true); setNodeState('output','active');
    await delay(200);
    setNodeState('output','done');
    addLog('MEMORY', `Run ${runId} persisted. Total runs: ${memory.runs.length}`, 'var(--green-ok)');
 
    // Update history panel
    updateHistory(runRecord);
    updateMemorySummary();
 
  } catch(err) {
    addSection(oc, 'tag-tool', 'ERROR', `<div style="color:var(--red-alert);font-size:13px">Pipeline error: ${err.message}</div>`);
  }
 
  btn.classList.remove('loading');
  btn.disabled = false;
}
 
async function callClaude(messages, system) {
  const res = await fetch(API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ model: MODEL, max_tokens: 1000, system, messages })
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.error?.message || 'API error');
  return data.content.map(b => b.text || '').join('');
}
 
function addSection(container, tagClass, tagText, innerHTML) {
  const div = document.createElement('div');
  div.className = 'output-section fade-in';
  div.innerHTML = `<div class="output-section-header"><span class="agent-tag ${tagClass}">${tagText}</span></div><div class="output-card"><div class="output-card-inner">${innerHTML}</div></div>`;
  container.appendChild(div);
  div.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  // Return reference to inner div for updating
  return div.querySelector('.output-card-inner');
}
 
function updateHistory(run) {
  const list = document.getElementById('history-list');
  // Clear empty state
  if (list.children.length === 1 && list.children[0].textContent.includes('No runs')) {
    list.innerHTML = '';
  }
  // Mark all inactive
  list.querySelectorAll('.history-item').forEach(i => i.classList.remove('active'));
  const dot = run.status === 'COMPLIANT' ? 'var(--green-ok)' : run.status === 'NON_COMPLIANT' ? 'var(--red-alert)' : 'var(--amber)';
  const item = document.createElement('div');
  item.className = 'history-item active';
  item.innerHTML = `<div class="history-title">${run.vessel}</div><div class="history-meta"><span class="history-dot" style="background:${dot}"></span>${run.id} · ${run.ts.slice(0,16)}</div>`;
  list.insertBefore(item, list.firstChild);
}
 
function updateMemorySummary() {
  document.getElementById('memory-summary').innerHTML = `<span style="color:var(--aqua)">runs:</span> ${memory.runs.length}<br><span style="color:var(--aqua)">violations:</span> ${memory.totalViolations}<br><span style="color:var(--aqua)">vessels:</span> [${memory.vessels.slice(-3).join(', ')}]`;
}
</script>
