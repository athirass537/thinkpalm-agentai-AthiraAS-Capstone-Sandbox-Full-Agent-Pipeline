        <div class="big-icon">⚓</div>
        <div>Configure your maritime task and run the pipeline</div>
        <div style="font-size:11px;color:var(--text-muted);font-family:'JetBrains Mono',monospace">AWAITING_INPUT</div>
      </div>
      <div id="output-content" style="display:none"></div>
